generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model adminactivitylog {
  id            String    @id
  adminUserId   String
  eventType     String
  description   String
  ipAddress     String?
  userAgent     String?
  targetPage    String?
  targetObject  String?
  previousValue Json?
  updatedValue  Json?
  status        String
  adminuser     adminuser @relation(fields: [adminUserId], references: [id], map: "AdminActivityLog_adminUserId_fkey")

  @@index([adminUserId], map: "AdminActivityLog_adminUserId_fkey")
}

model adminpermission {
  id         String     @id
  name       String     @unique(map: "AdminPermission_name_key")
  guard_name String
  createdAt  DateTime   @default(now())
  roleId     String?
  adminrole  adminrole? @relation(fields: [roleId], references: [id], map: "AdminPermission_roleId_fkey")

  @@index([name], map: "AdminPermission_name_idx")
  @@index([roleId], map: "AdminPermission_roleId_fkey")
}

model adminrole {
  id              String            @id
  name            adminrole_name    @unique(map: "AdminRole_name_key")
  description     String
  createdAt       DateTime          @default(now())
  adminpermission adminpermission[]
  adminuser       adminuser[]
}

model adminuser {
  id                     String                @id
  name                   String
  email                  String                @unique(map: "AdminUser_email_key")
  password               String
  emailVerified          DateTime?
  image                  String?
  roleId                 String?
  rememberToken          String?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean               @default(false)
  twoFactorRecoveryCodes String?
  lastLoginAt            DateTime?
  loginFailures          Int                   @default(0)
  lockedUntil            DateTime?
  passwordChangeAt       DateTime?
  createdAt              DateTime              @default(now())
  adminactivitylog       adminactivitylog[]
  adminrole              adminrole?            @relation(fields: [roleId], references: [id], map: "AdminUser_roleId_fkey")
  consultationrequest    consultationrequest[]
  contactinquiry         contactinquiry[]
  contentrevision        contentrevision[]
  inquirynote            inquirynote[]
  mediaasset             mediaasset[]
  servicerevision        servicerevision[]
  adminotps              adminotp[]

  @@index([roleId], map: "AdminUser_roleId_fkey")
}

model analyticsevent {
  id               String          @id
  eventType        String
  pageSlug         String?
  elementId        String?
  elementType      String?
  metadata         Json?
  visitorSessionId String?
  timestamp        DateTime        @default(now())
  visitorsession   visitorsession? @relation(fields: [visitorSessionId], references: [id], map: "AnalyticsEvent_visitorSessionId_fkey")

  @@index([visitorSessionId], map: "AnalyticsEvent_visitorSessionId_fkey")
}

model blogcategory {
  id          String     @id
  name        String     @unique(map: "BlogCategory_name_key")
  slug        String     @unique(map: "BlogCategory_slug_key")
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  blogpost    blogpost[]
}

model blogpost {
  id              String        @id
  slug            String        @unique(map: "BlogPost_slug_key")
  title           String
  excerpt         String        @db.Text
  content         String?       @db.LongText
  categoryId      String?
  categoryName    String?
  publishedAt     DateTime      @default(now())
  readTime        String?
  authorName      String?
  authorRole      String?
  authorAvatar    String?
  image           String?
  isExternal      Boolean       @default(false)
  sourceName      String?
  originalUrl     String?
  featured        Boolean       @default(false)
  isPublished     Boolean       @default(true)
  metaTitle       String?
  metaDescription String?       @db.Text
  metaKeywords    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  blogcategory    blogcategory? @relation(fields: [categoryId], references: [id], map: "BlogPost_categoryId_fkey")

  @@index([categoryId], map: "BlogPost_categoryId_fkey")
}

model clickevent {
  id           String   @id
  eventType    String
  pageSlug     String
  elementId    String
  elementTitle String
  timestamp    DateTime @default(now())
}

model consultationrequest {
  id                     String     @id
  referenceNo            String?    @unique
  fullName               String
  email                  String
  phone                  String
  companyName            String?
  category               String
  serviceSlug            String
  annualVolumeOrRevenue  String
  preferredContactMethod String
  message                String
  privacyConsent         Boolean    @default(true)
  status                 String     @default("new")
  appointmentDate        String?
  appointmentTime        String?
  meetingType            String?
  meetingLocation        String?
  cancellationReason     String?
  ipAddress              String?
  userAgent              String?
  assignedAdminId        String?
  assignedAdminName      String?
  notes                  String?    @db.Text
  communicationHistory   String?    @db.Text
  statusHistory          String?    @db.Text
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @default(now()) @updatedAt
  adminUserId            String?
  adminuser              adminuser? @relation(fields: [adminUserId], references: [id], map: "ConsultationRequest_adminUserId_fkey")

  @@index([adminUserId], map: "ConsultationRequest_adminUserId_fkey")
}

model appointment {
  id                 String    @id
  referenceNo        String    @unique
  customerName       String
  customerEmail      String
  customerPhone      String?
  serviceName        String?
  calendlyEventId    String?
  calendlyInviteeUri String?
  appointmentStart   DateTime?
  appointmentEnd     DateTime?
  meetingLocation    String?
  meetingUrl         String?
  appointmentStatus  String    @default("scheduled")
  cancelReason       String?
  webhookEventId     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerEmail])
  @@index([calendlyEventId])
  @@index([appointmentStatus])
}

model calendlywebhookdelivery {
  id          String    @id
  eventId     String    @unique
  eventType   String
  payload     Json
  status      String    @default("unprocessed")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model contactinquiry {
  id                   String        @id
  inquiryNumber        String?       @unique
  name                 String
  email                String
  phone                String?
  organization         String?
  inquiryType          String
  subject              String?
  message              String        @db.Text
  status               String        @default("new")
  assignedAdminId      String?
  assignedAdminName    String?
  sourcePage           String?
  ipAddress            String?
  userAgent            String?
  isRead               Boolean       @default(false)
  isArchived           Boolean       @default(false)
  firstRespondedAt     DateTime?
  resolvedAt           DateTime?
  statusHistory        String?       @db.Text
  activityLogs         String?       @db.Text
  communicationHistory String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt
  adminUserId          String?
  adminuser            adminuser?    @relation(fields: [adminUserId], references: [id], map: "ContactInquiry_adminUserId_fkey")
  inquirynote          inquirynote[]

  @@index([adminUserId], map: "ContactInquiry_adminUserId_fkey")
}

model careerapplication {
  id                 String   @id
  fullName           String   @db.VarChar(120)
  email              String   @db.VarChar(254)
  phone              String   @db.VarChar(32)
  country            String   @db.VarChar(100)
  city               String   @db.VarChar(100)
  position           String   @db.VarChar(191)
  experienceLevel    String?  @db.VarChar(100)
  yearsExperience    Float
  relevantSkills     String   @db.Text
  softwareKnowledge  String   @db.Text
  employmentStatus   String?  @db.VarChar(100)
  expectedSalary     String?  @db.VarChar(100)
  linkedinProfile    String?  @db.VarChar(500)
  coverLetter        String?  @db.Text
  additionalInfo     String?  @db.Text
  privacyAccepted    Boolean  @default(false)
  resumeOriginalName String   @db.VarChar(255)
  resumeStoredName   String   @db.VarChar(100)
  resumeMimeType     String   @db.VarChar(100)
  resumeSize         Int
  status             String   @default("new") @db.VarChar(32)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([position])
  @@index([createdAt])
}

model contentrevision {
  id           String      @id
  sectionId    String
  previousData Json
  newData      Json
  changedById  String?
  changeType   String
  changeNotes  String?
  adminUserId  String?
  adminuser    adminuser?  @relation(fields: [adminUserId], references: [id], map: "ContentRevision_adminUserId_fkey")
  pagesection  pagesection @relation(fields: [sectionId], references: [id], map: "ContentRevision_sectionId_fkey")

  @@index([adminUserId], map: "ContentRevision_adminUserId_fkey")
  @@index([sectionId], map: "ContentRevision_sectionId_fkey")
}

model globalsetting {
  id          String  @id
  key         String  @unique(map: "GlobalSetting_key_key")
  value       Json
  description String?
  category    String
  isPublic    Boolean @default(true)
}

model emailtemplate {
  id        String   @id @default(uuid())
  formType  String   @unique(map: "EmailTemplate_formType_key")
  subject   String   @db.VarChar(200)
  greeting  String   @default("Dear {{customerName}},")
  message   String   @db.LongText
  footer    String   @default("Best regards,&#10;{{brandName}} Team")
  branding  String?  @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formType])
  @@index([isActive])
}

model inquirynote {
  id             String         @id
  inquiryId      String
  note           String         @db.Text
  createdById    String
  authorName     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  adminuser      adminuser      @relation(fields: [createdById], references: [id], map: "InquiryNote_createdById_fkey")
  contactinquiry contactinquiry @relation(fields: [inquiryId], references: [id], map: "InquiryNote_inquiryId_fkey")

  @@index([createdById], map: "InquiryNote_createdById_fkey")
  @@index([inquiryId], map: "InquiryNote_inquiryId_fkey")
}

model mediaasset {
  id              String         @id
  filename        String
  originalName    String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  folder          String         @default("general")
  folderId        String?
  altText         String?
  caption         String?
  description     String?        @db.Text
  seoTitle        String?
  seoDescription  String?        @db.Text
  tags            Json?
  storageLocation String
  thumbnailUrl    String?
  isProcessed     Boolean        @default(false)
  processedUrl    String?
  fileHash        String?
  isArchived      Boolean        @default(false)
  uploadedById    String?
  adminUserId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  adminuser       adminuser?     @relation(fields: [adminUserId], references: [id], map: "MediaAsset_adminUserId_fkey")
  mediafolder     mediafolder?   @relation(fields: [folderId], references: [id])
  mediausage      mediausage[]
  mediaversion    mediaversion[]

  @@index([adminUserId], map: "MediaAsset_adminUserId_fkey")
  @@index([folderId])
  @@index([fileHash])
}

model mediafolder {
  id         String        @id
  name       String
  parentId   String?
  path       String
  isRoot     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  parent     mediafolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children   mediafolder[] @relation("FolderHierarchy")
  mediaasset mediaasset[]

  @@index([parentId])
}

model mediausage {
  id          String     @id
  mediaId     String
  pageId      String?
  sectionId   String?
  blogId      String?
  contentType String     @default("section")
  location    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  mediaasset  mediaasset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([pageId])
  @@index([sectionId])
  @@index([blogId])
}

model mediaversion {
  id            String     @id
  mediaId       String
  filename      String
  storagePath   String
  size          Int
  versionNumber Int        @default(1)
  createdById   String?
  createdAt     DateTime   @default(now())
  mediaasset    mediaasset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

model navigationitem {
  id            String       @id
  name          String
  slug          String       @unique(map: "NavigationItem_slug_key")
  pageId        String?
  url           String
  order         Int          @default(0)
  isVisible     Boolean      @default(true)
  target        String
  parentId      String?
  websitePageId String?
  websitepage   websitepage? @relation(fields: [websitePageId], references: [id], map: "NavigationItem_websitePageId_fkey")

  @@index([websitePageId], map: "NavigationItem_websitePageId_fkey")
}

model pagesection {
  id              String            @id
  pageId          String
  sectionKey      String
  sectionType     String
  title           String
  subheading      String?           @db.VarChar(500)
  description     String            @db.Text
  content         String?           @db.LongText
  draftData       String?           @db.LongText
  backgroundImage String?
  backgroundVideo String?
  imagePosition   String?
  imageAltText    String?
  isEnabled       Boolean           @default(true)
  displayOrder    Int
  revisionId      String?
  parentSectionId String?
  publishedAt     DateTime?
  updatedAt       DateTime          @default(now()) @updatedAt
  contentrevision contentrevision[]
  websitepage     websitepage       @relation(fields: [pageId], references: [id], map: "PageSection_pageId_fkey")

  @@index([pageId], map: "PageSection_pageId_fkey")
}

model pageseo {
  id                 String      @id
  pageId             String      @unique(map: "PageSEO_pageId_key")
  metaTitle          String
  metaDescription    String
  metaKeywords       Json?
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogTitle            String
  ogDescription      String
  ogImage            String?
  twitterTitle       String
  twitterDescription String
  twitterImage       String?
  structuredData     Json?
  sitemapPriority    String
  sitemapChange      String
  websitepage        websitepage @relation(fields: [pageId], references: [id], map: "PageSEO_pageId_fkey")
}

model pageview {
  id               String          @id
  pageSlug         String
  pageTitle        String
  visitorSessionId String?
  timestamp        DateTime        @default(now())
  duration         Int?
  scrollDepth      Int?
  deviceType       String?
  browser          String?
  os               String?
  country          String?
  visitorsession   visitorsession? @relation(fields: [visitorSessionId], references: [id], map: "PageView_visitorSessionId_fkey")

  @@index([visitorSessionId], map: "PageView_visitorSessionId_fkey")
}

model service {
  id               String            @id
  name             String
  slug             String            @unique(map: "Service_slug_key")
  categoryId       String
  shortDescription String
  fullDescription  String
  heroImage        String?
  thumbnailImage   String?
  iconName         String?
  additionalImages Json?
  video            String?
  gif              String?
  features         Json?
  benefits         Json?
  deliverables     Json?
  workflow         Json?
  faqs             Json?
  relatedSlugs     Json?
  idealFor         String?
  turnaroundTime   String?
  demoType         String?
  heroTagline      String?
  isFeatured       Boolean           @default(false)
  ctaText          String
  ctaUrl           String
  displayOrder     Int               @default(0)
  isPublished      Boolean           @default(true)
  publicationDate  DateTime?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  metaTitle        String?
  metaDescription  String?
  servicecategory  servicecategory   @relation(fields: [categoryId], references: [id], map: "Service_categoryId_fkey")
  servicerevision  servicerevision[]

  @@index([categoryId], map: "Service_categoryId_fkey")
}

model servicecategory {
  id           String    @id
  name         String
  slug         String    @unique(map: "ServiceCategory_slug_key")
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  isEnabled    Boolean   @default(true)
  parentId     String?
  service      service[]
}

model servicerevision {
  id           String     @id
  serviceId    String
  previousData Json
  newData      Json
  changedById  String?
  changeType   String
  changeNotes  String?
  adminUserId  String?
  adminuser    adminuser? @relation(fields: [adminUserId], references: [id], map: "ServiceRevision_adminUserId_fkey")
  service      service    @relation(fields: [serviceId], references: [id], map: "ServiceRevision_serviceId_fkey")

  @@index([adminUserId], map: "ServiceRevision_adminUserId_fkey")
  @@index([serviceId], map: "ServiceRevision_serviceId_fkey")
}

model systemlog {
  id         String  @id
  level      String
  message    String
  source     String
  details    Json?
  stackTrace String?
  ipAddress  String?
}

model visitorsession {
  id             String           @id
  sessionId      String
  ipAddress      String?
  userAgent      String?
  referrer       String?
  landingPage    String
  exitPage       String?
  duration       Int
  timestamp      DateTime         @default(now())
  analyticsevent analyticsevent[]
  pageview       pageview[]
}

model websitepage {
  id              String           @id
  slug            String           @unique(map: "WebsitePage_slug_key")
  title           String
  description     String?
  status          String           @default("draft")
  type            String
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  publishedAt     DateTime?
  navigationitem  navigationitem[]
  pagesection     pagesection[]
  pageseo         pageseo?
}

enum adminrole_name {
  SUPER_ADMIN
  CONTENT_MANAGER
  SEO_MANAGER
  ANALYST
  READ_ONLY_AUDITOR
}

// ─── Visitor Tracking & Activity Logging ─────────────────────────────────────

model visitor {
  id                   String               @id @default(uuid())
  visitorUuid          String               @unique @db.VarChar(36)
  displayName          String?              @db.VarChar(255)
  email                String?              @db.VarChar(255)
  identificationStatus String               @default("anonymous") @db.VarChar(50)
  firstVisit           DateTime             @default(now())
  lastVisit            DateTime             @default(now())
  totalVisits          Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  devices              visitordevice[]
  activityLogs         visitoractivitylog[]
  formSubmissions      formsubmission[]
  sectionViews         sectionview[]
  elementClicks        elementclick[]
}

model visitordevice {
  id               String   @id @default(uuid())
  visitorId        String
  deviceIdentifier String   @db.VarChar(64)
  browser          String?  @db.VarChar(100)
  operatingSystem  String?  @db.VarChar(100)
  deviceType       String?  @db.VarChar(50)
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @updatedAt
  visitor          visitor  @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
}

model visitoractivitylog {
  id           String   @id @default(uuid())
  visitorId    String?
  activityType String   @db.VarChar(100)
  page         String?  @db.VarChar(255)
  pageUrl      String?  @db.VarChar(500)
  description  String?  @db.Text
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.VarChar(500)
  metadata     Json?
  status       String   @default("success") @db.VarChar(50)
  createdAt    DateTime @default(now())
  visitor      visitor? @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([createdAt])
  @@index([activityType])
}

model formsubmission {
  id               String   @id @default(uuid())
  visitorId        String?
  formType         String   @db.VarChar(100)
  submittedName    String?  @db.VarChar(255)
  submittedEmail   String?  @db.VarChar(255)
  submissionStatus String   @default("success") @db.VarChar(50)
  metadata         Json?
  createdAt        DateTime @default(now())
  visitor          visitor? @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([formType])
}

model sectionview {
  id               String   @id @default(uuid())
  visitorId        String?
  pageSlug         String   @db.VarChar(100)
  sectionKey       String   @db.VarChar(100)
  sectionName      String   @db.VarChar(255)
  dwellTimeSeconds Int      @default(0)
  timestamp        DateTime @default(now())
  visitor          visitor? @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([pageSlug])
  @@index([sectionKey])
  @@index([timestamp])
}

model elementclick {
  id             String   @id @default(uuid())
  visitorId      String?
  elementId      String   @db.VarChar(100)
  elementName    String   @db.VarChar(255)
  elementType    String   @default("button") @db.VarChar(50)
  intentCategory String   @default("general") @db.VarChar(50)
  pageSlug       String   @db.VarChar(100)
  sectionKey     String?  @db.VarChar(100)
  targetUrl      String?  @db.VarChar(500)
  timestamp      DateTime @default(now())
  visitor        visitor? @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([elementId])
  @@index([pageSlug])
  @@index([sectionKey])
  @@index([intentCategory])
  @@index([timestamp])
}

model adminotp {
  id          String    @id @default(uuid())
  adminUserId String
  otpHashed   String    @db.VarChar(255)
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  ipAddress   String?   @db.VarChar(100)
  userAgent   String?   @db.Text
  createdAt   DateTime  @default(now())

  adminuser adminuser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([isUsed])
}
